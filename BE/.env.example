# ============================================================
# Bunny Backend — Environment Variables
# Sao chép file này thành .env và điền giá trị thực
# ============================================================

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=takeaway

# JWT
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES=7d

# Server
PORT=3000
